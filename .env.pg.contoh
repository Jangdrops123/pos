# Contoh konfigurasi PostgreSQL untuk NusaSuite (salin menjadi .env bila siap migrasi)
# Selama DATABASE_URL kosong, aplikasi tetap memakai SQLite (data/app.db) — aman untuk transisi.

# PostgreSQL tujuan (format: DATABASE_URL=postgresql://nusa:Jajang123@host.docker.internal:5432/nusapos
DATABASE_URL=postgresql://nusa:nusa@localhost:5432/nusapos

# File SQLite sumber untuk script migrasi satu-kali (scripts/migrasi-ke-pg.ts)
SQLITE_FILE=data/app.db

# Port API (sama seperti sebelumnya)
API_PORT=3001
HOST=127.0.0.1
