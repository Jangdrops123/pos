{
  "name": "nusapos-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aplikasi terpadu POS + WMS + Akuntansi untuk retail Indonesia",
  "scripts": {
    "db:migrate": "tsx server/migrate.ts",
    "dev": "npm run db:migrate && concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host",
    "dev:web:https": "vite --host --mode https",
    "dev:https": "npm run db:migrate && concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web:https\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
